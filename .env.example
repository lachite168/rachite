HOST=127.0.0.1
PORT=3000
# Optional Vite proxy override (otherwise uses PORT)
# API_PROXY_TARGET=http://127.0.0.1:3000
DATABASE_URL=mysql://rachite:rachite-local@127.0.0.1:3306/rachite
# Compose uses the internal DB hostname. Set COMPOSE_DATABASE_URL to override it.
MARIADB_DATABASE=rachite
MARIADB_USER=rachite
MARIADB_PASSWORD=rachite-local
MARIADB_ROOT_PASSWORD=rachite-root-local
RUST_LOG=rachite_api=info,tower_http=info

TRAQ_ORIGIN=https://q.trap.jp
TRAQ_BOT_NAME=BOT_lachite
# Set both values to enable the Bot. Prefer a test Bot for local development.
TRAQ_BOT_ID=
TRAQ_BOT_TOKEN=
